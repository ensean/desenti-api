# 复制为 .env 并按需修改。切勿提交真实密钥到版本库。

# 合法 API Key 列表（逗号分隔）—— 引导 Key
DESENTI_API_KEYS=change-me-in-production

# 运行时受管 API Key 文件（管理页面增删的 Key 落盘于此，与引导 Key 并集生效）
# 容器内建议挂载到持久卷，否则容器重建后受管 Key 丢失
DESENTI_API_KEYS_FILE=api_keys.txt

# 管理页面（/admin）令牌。留空则管理功能完全禁用（404）。
# 设为强随机值，例如：openssl rand -hex 24
DESENTI_ADMIN_TOKEN=

# 模型版本号（出现在响应 meta 中）
DESENTI_MODEL_VERSION=1.0.0

# 限流：每个 Key 每分钟最大请求数
DESENTI_RATE_LIMIT_PER_MINUTE=600

# 文本字节上限（默认 100KB）
DESENTI_MAX_TEXT_BYTES=102400

# ---------------- 识别模式 ----------------
# 默认模式：fast=字典+正则+spaCy；accurate=fast + LLM
DESENTI_DEFAULT_MODE=fast

# ---------------- fast 模式：字典 + spaCy ----------------
# 敏感词典文件路径（命中优先级最高，热更新）
DESENTI_DICT_FILE=sensitive_dict.txt
# 是否启用 spaCy NER（公司/人名/地址兜底）。关闭或模型缺失则降级为「字典+正则」
DESENTI_SPACY_ENABLED=true
# spaCy 中文模型。生产推荐 zh_core_web_trf（~400MB BERT，需 torch）；
# 轻量集成可用 zh_core_web_sm；内网可填本地模型目录路径
DESENTI_SPACY_MODEL=zh_core_web_trf

# ---------------- LLM 后端（accurate 模式，自托管于 EC2 host） ----------------
# 是否启用 LLM。关闭时 accurate 请求自动降级为 fast。
DESENTI_LLM_ENABLED=false
# OpenAI 兼容 base url。Ollama: http://<host>:11434/v1 ；vLLM: http://<host>:8000/v1
# 容器内访问宿主机 Ollama 用 http://host.docker.internal:11434/v1
DESENTI_LLM_BASE_URL=http://127.0.0.1:11434/v1
# 部分后端需要 Key；Ollama 可留默认
DESENTI_LLM_API_KEY=not-needed
# 模型名（EC2 host 自托管）。中文合同推荐 qwen3.5:9b（官方库，256K 上下文）
# 备选纯中文最优：glm4:9b
DESENTI_LLM_MODEL=qwen3.5:9b
# API 风格：ollama 用原生 /api/chat（正确支持关闭思考，Qwen3.5 必需，
# 否则模型会生成数千推理 token 使单次延迟从 ~3s 飙到 ~60s）；
# openai 用 /v1/chat/completions（vLLM 等标准 OpenAI 兼容后端）
DESENTI_LLM_API_STYLE=ollama
# 单次请求超时（秒）。SLA 已放宽，给模型留足生成时间
DESENTI_LLM_TIMEOUT_SECONDS=120
# 单个分块最大字符数。qwen3.5 256K 上下文，100KB 合同可一次喂入
DESENTI_LLM_MAX_CHARS_PER_CHUNK=40000
# 关闭思考模式（抽取任务应关闭，避免 <think> 块干扰 JSON）
DESENTI_LLM_DISABLE_THINKING=true
